<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GameOfLife.MainWindow"
        Title="GameOfLife"
        Width="1000"
        Height="700">

    <Grid RowDefinitions="Auto,*,Auto">

        <StackPanel Orientation="Horizontal"
                    Spacing="10"
                    Margin="10">

            <Button Content="Start"
                    Click="StartClick"/>

            <Button Content="Stop"
                    Click="StopClick"/>

            <Button Content="Reset"
                    Click="ResetStopButtonClick"/>

        </StackPanel>

        <UniformGrid x:Name="gameGrid"
                     Grid.Row="1"
                     Rows="20"
                     Columns="30"
                     Margin="10"/>

        <TextBlock x:Name="tbDebug"
                   Grid.Row="2"
                   Margin="10"
                   FontSize="16"
                   Text="Generation: 1"/>

    </Grid>
</Window>